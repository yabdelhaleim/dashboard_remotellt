APP_NAME=Remotelly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# ============================================================
# Analytics & Tracking
# ضيف هنا الـ IDs من الـ dashboards بتاعتك
# لو فاضي السكربت مش بيظهر على الصفحة
# ============================================================
# Google Analytics GA4 Measurement ID (Format: G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID (numeric, e.g. 123456789012345)
META_PIXEL_ID=

# ============================================================
# Telegram Bot — Free instant push notifications to mobile + desktop
# ============================================================
# Bot Token from @BotFather on Telegram (Format: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=

# Your personal chat_id (get via https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# ============================================================
# Database — MySQL
# ضع بيانات الـ MySQL الخاصة بالسيرفر هنا
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ============================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=your_mail_host
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS="info@remotelly.com"
MAIL_FROM_NAME="Remotelly"

# ============================================================
# Vite / Frontend
# ============================================================
VITE_APP_NAME="Remotelly"
VITE_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

VITE_WHATSAPP_NUMBER=201000000000

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# لوحة تحكم SaaS الرئيسية (تظهر في /admin → أنظمتي)
# مثال: https://app.remotelly.com/super-admin/dashboard
VITE_SAAS_ADMIN_URL=
